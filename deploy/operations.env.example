# Store actual values privately on the deployment host; never commit them.
MEALCHECK_ALERT_PROVIDER=wecom
MEALCHECK_ALERT_WEBHOOK=https://replace-with-private-webhook
# Configure rclone crypt over a private bucket in another region/account.
MEALCHECK_BACKUP_REMOTE=mealcheckcrypt:mealcheck-backups
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
MEALCHECK_BACKUP_PUSHGATEWAY=http://127.0.0.1:19091
# Prices share one declared currency per deployment; fill from provider contract.
MEALCHECK_AI_INPUT_COST_PER_MILLION=0
MEALCHECK_AI_OUTPUT_COST_PER_MILLION=0
