[Unit]
Description=MealCheck weekly restore from encrypted off-site backup
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/opt/mealcheck-fullstack
EnvironmentFile=/opt/mealcheck-fullstack/.env.operations
ExecStart=/usr/bin/python3 deploy/scripts/operations_backup.py --mode restore --output /var/lib/mealcheck-restore-drills
UMask=0077
TimeoutStartSec=4h
