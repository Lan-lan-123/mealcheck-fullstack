# Backend database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mealcheck
SPRING_DATASOURCE_USERNAME=mealcheck
SPRING_DATASOURCE_PASSWORD=mealcheck123
MEALCHECK_DB_MAX_POOL_SIZE=12
MEALCHECK_DB_MIN_IDLE=2
MEALCHECK_DB_CONNECTION_TIMEOUT_MILLIS=2000
MEALCHECK_DB_VALIDATION_TIMEOUT_MILLIS=1000
MEALCHECK_DB_QUERY_TIMEOUT=3s
MEALCHECK_DB_QUERY_TIMEOUT_MILLIS=3000

# JWT: production/demo
MEALCHECK_JWT_SECRET=mealcheck-jwt-secret-change-me-please-32chars

# Uploaded images are decoded, dimension-checked and normalized to metadata-free JPEG.
MEALCHECK_UPLOAD_MAX_INPUT_BYTES=10485760
MEALCHECK_UPLOAD_MAX_WIDTH=4096
MEALCHECK_UPLOAD_MAX_HEIGHT=4096
MEALCHECK_UPLOAD_MAX_PIXELS=16777216
MEALCHECK_UPLOAD_NORMALIZED_MAX_EDGE=2560
MEALCHECK_UPLOAD_JPEG_QUALITY=0.90
MEALCHECK_UPLOAD_ORPHAN_CLEANUP_ENABLED=true
MEALCHECK_UPLOAD_ORPHAN_CLEANUP_CRON=0 30 3 * * *
MEALCHECK_UPLOAD_ORPHAN_GRACE_HOURS=24

# Qwen2.5-VL OpenAI-compatible API
MEALCHECK_AI_API_KEY=API_KEY
MEALCHECK_AI_BASE_URL=***
MEALCHECK_AI_MODEL=***

# OpenAI-compatible semantic embedding API. The configured model must support
# MEALCHECK_KNOWLEDGE_EMBEDDING_DIM output dimensions.
MEALCHECK_KNOWLEDGE_EMBEDDING_API_KEY=API_KEY
MEALCHECK_KNOWLEDGE_EMBEDDING_BASE_URL=***
MEALCHECK_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
MEALCHECK_KNOWLEDGE_EMBEDDING_DIM=512
MEALCHECK_KNOWLEDGE_VECTOR_STORAGE=halfvec
MEALCHECK_KNOWLEDGE_VECTOR_WEIGHT=0.65
MEALCHECK_KNOWLEDGE_KEYWORD_WEIGHT=0.25
MEALCHECK_KNOWLEDGE_CATEGORY_WEIGHT=0.10
MEALCHECK_KNOWLEDGE_RRF_K=60

# Optional second-stage reranker. The URL accepts model/query/documents/top_n and
# returns results with index/relevance_score (for example Jina-compatible APIs).
# Rough and reranker ranks are fused with Weighted RRF; the raw model score is
# retained and MEALCHECK_KNOWLEDGE_RERANKER_MIN_SCORE controls no-answer rejection.
MEALCHECK_KNOWLEDGE_RERANK_ENABLED=false
MEALCHECK_KNOWLEDGE_RERANK_URL=https://api.jina.ai/v1/rerank
MEALCHECK_KNOWLEDGE_RERANK_API_KEY=API_KEY
MEALCHECK_KNOWLEDGE_RERANK_MODEL=jina-reranker-v2-base-multilingual
MEALCHECK_KNOWLEDGE_RERANK_CANDIDATE_MULTIPLIER=4
MEALCHECK_KNOWLEDGE_RERANK_MODEL_WEIGHT=0.75
MEALCHECK_KNOWLEDGE_RERANK_TIMEOUT_SECONDS=10
MEALCHECK_KNOWLEDGE_RERANKER_MIN_SCORE=0.20
MEALCHECK_KNOWLEDGE_RESULT_FILTER_ENABLED=true
MEALCHECK_KNOWLEDGE_RESULT_MIN_SCORE=0.35
MEALCHECK_KNOWLEDGE_RESULT_RELATIVE_SCORE=0.60
MEALCHECK_KNOWLEDGE_RESULT_DEDUP_SIMILARITY=0.88
MEALCHECK_KNOWLEDGE_RESULT_CANDIDATE_MULTIPLIER=4
MEALCHECK_KNOWLEDGE_CHUNK_MIN_TOKENS=300
MEALCHECK_KNOWLEDGE_CHUNK_MAX_TOKENS=500
MEALCHECK_KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
MEALCHECK_KNOWLEDGE_SPLITTER_STRATEGY=recursive-markdown
MEALCHECK_KNOWLEDGE_SOURCE_VERSION=v2-recursive
MEALCHECK_KNOWLEDGE_BENCHMARK_REGRESSION_TOLERANCE=0.02

# Redis token-bucket rate limiting. Defaults preserve roughly 20 assistant calls/minute
# and 10 meal-analysis calls/minute while limiting instantaneous bursts.
MEALCHECK_RATE_LIMIT_ASSISTANT_CAPACITY=5
MEALCHECK_RATE_LIMIT_ASSISTANT_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_ASSISTANT_REFILL_PERIOD_SECONDS=3
MEALCHECK_RATE_LIMIT_ASSISTANT_REQUEST_COST=1
MEALCHECK_RATE_LIMIT_MEAL_CAPACITY=3
MEALCHECK_RATE_LIMIT_MEAL_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_MEAL_REFILL_PERIOD_SECONDS=6
MEALCHECK_RATE_LIMIT_MEAL_REQUEST_COST=1

# Weekly report batch size (processed asynchronously)
MEALCHECK_WEEKLY_REPORT_BATCH_SIZE=100
MEALCHECK_WEEKLY_REPORT_EXECUTOR_CORE_POOL_SIZE=2
MEALCHECK_WEEKLY_REPORT_EXECUTOR_MAX_POOL_SIZE=4
MEALCHECK_WEEKLY_REPORT_EXECUTOR_QUEUE_CAPACITY=20
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_CORE_POOL_SIZE=2
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_MAX_POOL_SIZE=4
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_QUEUE_CAPACITY=20
MEALCHECK_WEEKLY_REPORT_WORKER_BATCH_SIZE=4
MEALCHECK_WEEKLY_REPORT_MAX_ATTEMPTS=3
MEALCHECK_WEEKLY_REPORT_STALE_LEASE_SECONDS=600
MEALCHECK_WEEKLY_REPORT_WORKER_DELAY_MILLIS=5000
MEALCHECK_WEEKLY_REPORT_MULTI_AGENT_ENABLED=true
MEALCHECK_WEEKLY_REPORT_MAX_REVIEW_REVISIONS=1
MEALCHECK_WEEKLY_REPORT_RAG_LIMIT=5
MEALCHECK_WEEKLY_REPORT_AGENT_TIMEOUT_SECONDS=30

# MCP Streamable HTTP server (requires the same JWT Authorization header as REST APIs)
MEALCHECK_MCP_ENABLED=true
MEALCHECK_MCP_ENDPOINT=/mcp

# Local model Function Calling (off by default; MCP server remains independently available)
MEALCHECK_ASSISTANT_FUNCTION_CALLING_ENABLED=false
MEALCHECK_ASSISTANT_FUNCTION_CALLING_MAX_TOOL_ROUNDS=3
MEALCHECK_ASSISTANT_FUNCTION_CALLING_MAX_TOOL_CALLS=6
MEALCHECK_ASSISTANT_FUNCTION_CALLING_TOTAL_TIMEOUT_SECONDS=30

# Layered assistant memory: recent token window + rolling summary + relevant older messages
MEALCHECK_ASSISTANT_MEMORY_HISTORY_TOKEN_BUDGET=1200
MEALCHECK_ASSISTANT_MEMORY_RECENT_MESSAGES=6
MEALCHECK_ASSISTANT_MEMORY_SUMMARY_MAX_TOKENS=500
MEALCHECK_ASSISTANT_MEMORY_RELEVANT_MESSAGES=4
MEALCHECK_ASSISTANT_MEMORY_RECENT_DATABASE_MESSAGES=40
MEALCHECK_ASSISTANT_MEMORY_SUMMARY_BATCH_MESSAGES=100

# Parallel assistant data sources and remote AI resilience
MEALCHECK_ASSISTANT_HTTP_POOL_SIZE=8
MEALCHECK_ASSISTANT_HTTP_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_DB_POOL_SIZE=6
MEALCHECK_ASSISTANT_DB_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_RAG_POOL_SIZE=4
MEALCHECK_ASSISTANT_RAG_QUEUE_CAPACITY=8
MEALCHECK_ASSISTANT_BACKGROUND_POOL_SIZE=2
MEALCHECK_ASSISTANT_BACKGROUND_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_TOOLS_TIMEOUT_MILLIS=2500
MEALCHECK_ASSISTANT_TOOLS_TOTAL_TIMEOUT_MILLIS=3000
MEALCHECK_REMOTE_MAX_ATTEMPTS=2
MEALCHECK_REMOTE_INITIAL_BACKOFF_MILLIS=200
MEALCHECK_REMOTE_FAILURE_THRESHOLD=5
MEALCHECK_REMOTE_OPEN_DURATION_SECONDS=30
MEALCHECK_REMOTE_MAX_CONCURRENT_CALLS=8

# React dev server CORS
MEALCHECK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
