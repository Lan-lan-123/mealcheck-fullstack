# RabbitMQ for async image analysis (development credentials only).
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mealcheck
SPRING_RABBITMQ_PASSWORD=mealcheck-rabbit-dev
MEALCHECK_ANALYSIS_DISPATCH=rabbitmq
MEALCHECK_ANALYSIS_CONCURRENCY=40
MEALCHECK_ANALYSIS_MAX_OUTSTANDING=200
# DB image payload budget includes unfinished and retained failed uploads (512 MiB).
MEALCHECK_ANALYSIS_MAX_STORED_IMAGE_BYTES=536870912
MEALCHECK_ANALYSIS_MAX_OUTSTANDING_PER_USER=2
MEALCHECK_ANALYSIS_WORKER_ENABLED=true
MEALCHECK_ANALYSIS_OUTBOX_POLL_MS=1000
MEALCHECK_ANALYSIS_OUTBOX_WINDOW_SIZE=8
MEALCHECK_ANALYSIS_OUTBOX_CONFIRM_TIMEOUT_MS=5000

# Backend database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mealcheck
SPRING_DATASOURCE_USERNAME=mealcheck
SPRING_DATASOURCE_PASSWORD=mealcheck123
MEALCHECK_DB_MAX_POOL_SIZE=12
MEALCHECK_DB_MIN_IDLE=2
MEALCHECK_DB_CONNECTION_TIMEOUT_MILLIS=2000
MEALCHECK_DB_VALIDATION_TIMEOUT_MILLIS=1000
MEALCHECK_DB_QUERY_TIMEOUT=3s
MEALCHECK_DB_QUERY_TIMEOUT_MILLIS=3000

# JWT: production/demo
MEALCHECK_JWT_SECRET=mealcheck-jwt-secret-change-me-please-32chars
# Change this independently on all replicas after restoring an old database backup.
MEALCHECK_AUTH_GENERATION=cookie-v1
# Local HTTP development only; production always requires Secure cookies.
MEALCHECK_AUTH_COOKIE_SECURE=false

# Uploaded images are decoded, dimension-checked and normalized to metadata-free JPEG.
MEALCHECK_UPLOAD_MAX_INPUT_BYTES=10485760
MEALCHECK_UPLOAD_MAX_WIDTH=4096
MEALCHECK_UPLOAD_MAX_HEIGHT=4096
MEALCHECK_UPLOAD_MAX_PIXELS=16777216
MEALCHECK_UPLOAD_NORMALIZED_MAX_EDGE=2560
MEALCHECK_UPLOAD_JPEG_QUALITY=0.90
MEALCHECK_UPLOAD_ORPHAN_CLEANUP_ENABLED=true
MEALCHECK_UPLOAD_ORPHAN_CLEANUP_CRON=0 30 3 * * *
MEALCHECK_UPLOAD_ORPHAN_GRACE_HOURS=24

# SiliconFlow OpenAI-compatible API (text and vision)
MEALCHECK_AI_API_KEY=API_KEY
MEALCHECK_AI_BASE_URL=https://api.siliconflow.cn/v1
MEALCHECK_AI_MODEL=Qwen/Qwen3.8-27B
# Image recognition uses a vision-capable model on the same connection.
MEALCHECK_AI_VISION_MODEL=Qwen/Qwen3.8-27B
# Optional stable secret for encrypted administrator AI settings. Blank derives from JWT secret.
MEALCHECK_AI_SETTINGS_ENCRYPTION_KEY=
# Qwen3.8 Max/Flash task profiles: off | low | provider. Other models keep their provider vocabulary.
MEALCHECK_AI_VISION_THINKING_MODE=off
MEALCHECK_AI_ADVICE_THINKING_MODE=off
MEALCHECK_AI_ASSISTANT_THINKING_MODE=off
MEALCHECK_AI_WEEKLY_THINKING_MODE=off
# Used by low mode, bounded to half the total completion allowance to leave room for the answer.
MEALCHECK_AI_THINKING_BUDGET_TOKENS=512
# Independent Model Studio judge. Set its own Aliyun key; do not reuse a SiliconFlow key.
MEALCHECK_ASSISTANT_EVALUATION_JUDGE_API_KEY=
MEALCHECK_ASSISTANT_EVALUATION_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEALCHECK_ASSISTANT_EVALUATION_JUDGE_MODEL=kimi-k3
MEALCHECK_ASSISTANT_EVALUATION_JUDGE_TIMEOUT_SECONDS=60

# Optional dedicated embedding endpoint. Empty key/URL reuse an existing Aliyun
# chat endpoint/key when selected in the admin UI. Other providers are not reused.
# Selecting LOCAL never calls a remote embedding model.
MEALCHECK_KNOWLEDGE_EMBEDDING_API_KEY=
MEALCHECK_KNOWLEDGE_EMBEDDING_BASE_URL=
MEALCHECK_KNOWLEDGE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
MEALCHECK_KNOWLEDGE_EMBEDDING_DIM=512
# BGE-M3 uses 1024 dimensions; set this to false for fixed-dimension providers.
MEALCHECK_KNOWLEDGE_EMBEDDING_SEND_DIMENSIONS=true
MEALCHECK_KNOWLEDGE_VECTOR_STORAGE=halfvec
MEALCHECK_KNOWLEDGE_VECTOR_WEIGHT=0.65
MEALCHECK_KNOWLEDGE_KEYWORD_WEIGHT=0.25
MEALCHECK_KNOWLEDGE_CATEGORY_WEIGHT=0.10
MEALCHECK_KNOWLEDGE_RRF_K=60

# Optional second-stage reranker. The URL accepts model/query/documents/top_n and
# returns results with index/relevance_score (for example Jina-compatible APIs).
# Rough and reranker ranks are fused with Weighted RRF; the raw model score is
# retained and MEALCHECK_KNOWLEDGE_RERANKER_MIN_SCORE controls no-answer rejection.
MEALCHECK_KNOWLEDGE_RERANK_ENABLED=true
MEALCHECK_KNOWLEDGE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
MEALCHECK_KNOWLEDGE_RERANK_API_KEY=API_KEY
MEALCHECK_KNOWLEDGE_RERANK_MODEL=qwen3.7-text-rerank
MEALCHECK_KNOWLEDGE_RERANK_CANDIDATE_MULTIPLIER=4
MEALCHECK_KNOWLEDGE_RERANK_MODEL_WEIGHT=0.75
MEALCHECK_KNOWLEDGE_RERANK_TIMEOUT_SECONDS=10
MEALCHECK_KNOWLEDGE_RERANKER_MIN_SCORE=0.20
MEALCHECK_KNOWLEDGE_RESULT_FILTER_ENABLED=true
MEALCHECK_KNOWLEDGE_RESULT_MIN_SCORE=0.35
MEALCHECK_KNOWLEDGE_RESULT_RELATIVE_SCORE=0.60
MEALCHECK_KNOWLEDGE_RESULT_DEDUP_SIMILARITY=0.88
MEALCHECK_KNOWLEDGE_RESULT_CANDIDATE_MULTIPLIER=4
MEALCHECK_KNOWLEDGE_CHUNK_MIN_TOKENS=300
MEALCHECK_KNOWLEDGE_CHUNK_MAX_TOKENS=500
MEALCHECK_KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
MEALCHECK_KNOWLEDGE_SPLITTER_STRATEGY=recursive-markdown
MEALCHECK_KNOWLEDGE_SOURCE_VERSION=v8-longform-200-boundary-v2
# Longer than one embedding call; source changes after initialization require admin reindex.
MEALCHECK_KNOWLEDGE_SOURCE_SYNC_LEASE_SECONDS=120
MEALCHECK_KNOWLEDGE_BENCHMARK_REGRESSION_TOLERANCE=0.02

# Redis token-bucket rate limiting. Defaults preserve roughly 20 assistant calls/minute
# and 10 meal-analysis calls/minute while limiting instantaneous bursts.
MEALCHECK_RATE_LIMIT_LOGIN_CAPACITY=5
MEALCHECK_RATE_LIMIT_LOGIN_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_LOGIN_REFILL_PERIOD_SECONDS=60
MEALCHECK_RATE_LIMIT_REGISTRATION_CAPACITY=3
MEALCHECK_RATE_LIMIT_REGISTRATION_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_REGISTRATION_REFILL_PERIOD_SECONDS=300
MEALCHECK_RATE_LIMIT_CAPTCHA_CAPACITY=10
MEALCHECK_RATE_LIMIT_CAPTCHA_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_CAPTCHA_REFILL_PERIOD_SECONDS=10
MEALCHECK_RATE_LIMIT_ASSISTANT_CAPACITY=5
MEALCHECK_RATE_LIMIT_ASSISTANT_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_ASSISTANT_REFILL_PERIOD_SECONDS=3
MEALCHECK_RATE_LIMIT_ASSISTANT_REQUEST_COST=1
MEALCHECK_RATE_LIMIT_MEAL_CAPACITY=3
MEALCHECK_RATE_LIMIT_MEAL_REFILL_TOKENS=1
MEALCHECK_RATE_LIMIT_MEAL_REFILL_PERIOD_SECONDS=6
MEALCHECK_RATE_LIMIT_MEAL_REQUEST_COST=1

# Weekly report batch size (processed asynchronously)
MEALCHECK_WEEKLY_REPORT_BATCH_SIZE=100
MEALCHECK_WEEKLY_REPORT_ACTIVE_DAYS=30
MEALCHECK_WEEKLY_REPORT_ENQUEUE_RESUME_MS=60000
MEALCHECK_RETENTION_RESUME_MS=60000
MEALCHECK_WEEKLY_REPORT_EXECUTOR_CORE_POOL_SIZE=2
MEALCHECK_WEEKLY_REPORT_EXECUTOR_MAX_POOL_SIZE=4
MEALCHECK_WEEKLY_REPORT_EXECUTOR_QUEUE_CAPACITY=0
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_CORE_POOL_SIZE=2
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_MAX_POOL_SIZE=4
MEALCHECK_WEEKLY_REPORT_AGENT_EXECUTOR_QUEUE_CAPACITY=20
MEALCHECK_WEEKLY_REPORT_WORKER_BATCH_SIZE=4
MEALCHECK_WEEKLY_REPORT_MAX_ATTEMPTS=3
MEALCHECK_WEEKLY_REPORT_STALE_LEASE_SECONDS=600
MEALCHECK_WEEKLY_REPORT_WORKER_DELAY_MILLIS=5000
MEALCHECK_WEEKLY_REPORT_MULTI_AGENT_ENABLED=true
MEALCHECK_WEEKLY_REPORT_MAX_REVIEW_REVISIONS=1
MEALCHECK_WEEKLY_REPORT_RAG_LIMIT=5
MEALCHECK_WEEKLY_REPORT_AGENT_TIMEOUT_SECONDS=30
MEALCHECK_WEEKLY_REPORT_COORDINATION_HEARTBEAT_MILLIS=30000
MEALCHECK_WEEKLY_REPORT_COORDINATION_STALE_SECONDS=900

# MCP Streamable HTTP server (requires the same JWT Authorization header as REST APIs)
MEALCHECK_MCP_ENABLED=true
MEALCHECK_MCP_ENDPOINT=/mcp

# Local model Function Calling (development default on; MCP server remains independently available)
MEALCHECK_ASSISTANT_FUNCTION_CALLING_ENABLED=true
MEALCHECK_ASSISTANT_FUNCTION_CALLING_MAX_TOOL_ROUNDS=3
MEALCHECK_ASSISTANT_FUNCTION_CALLING_MAX_TOOL_CALLS=6
MEALCHECK_ASSISTANT_FUNCTION_CALLING_TOTAL_TIMEOUT_SECONDS=90
# Knowledge-only expansion leaves this tail for evidence review; includes 1s finalization.
MEALCHECK_ASSISTANT_REVIEW_RESERVE_SECONDS=30

# Layered assistant memory: recent token window + rolling summary + relevant older messages
MEALCHECK_ASSISTANT_MEMORY_HISTORY_TOKEN_BUDGET=1200
MEALCHECK_ASSISTANT_MEMORY_RECENT_MESSAGES=6
MEALCHECK_ASSISTANT_MEMORY_SUMMARY_MAX_TOKENS=500
MEALCHECK_ASSISTANT_MEMORY_RELEVANT_MESSAGES=4
MEALCHECK_ASSISTANT_MEMORY_RECENT_DATABASE_MESSAGES=40
MEALCHECK_ASSISTANT_MEMORY_SUMMARY_BATCH_MESSAGES=100

# Parallel assistant data sources and remote AI resilience
MEALCHECK_ASSISTANT_HTTP_POOL_SIZE=8
MEALCHECK_ASSISTANT_HTTP_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_DB_POOL_SIZE=6
MEALCHECK_ASSISTANT_DB_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_RAG_POOL_SIZE=4
MEALCHECK_ASSISTANT_RAG_QUEUE_CAPACITY=8
MEALCHECK_ASSISTANT_BACKGROUND_POOL_SIZE=2
MEALCHECK_ASSISTANT_BACKGROUND_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_TOOLS_TIMEOUT_MILLIS=15000
MEALCHECK_ASSISTANT_TOOLS_TOTAL_TIMEOUT_MILLIS=20000
MEALCHECK_REMOTE_MAX_ATTEMPTS=2
MEALCHECK_REMOTE_INITIAL_BACKOFF_MILLIS=200
MEALCHECK_REMOTE_FAILURE_THRESHOLD=5
MEALCHECK_REMOTE_OPEN_DURATION_SECONDS=30
MEALCHECK_REMOTE_MAX_CONCURRENT_CALLS=42

# Upload admission and decoding for the verified 50-person burst profile.
MEALCHECK_UPLOAD_MAX_CONCURRENT_DECODES=2
MEALCHECK_UPLOAD_MAX_PENDING_DECODES=62
MEALCHECK_UPLOAD_DECODE_WAIT_MILLIS=15000
MEALCHECK_UPLOAD_TEMPORARY_MAX_BYTES=1073741824
MEALCHECK_RATE_LIMIT_UPLOAD_INGRESS_CAPACITY=20

# Backend container resources matched to the verified capacity profile.
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.50
FRONTEND_REQUEST_TMPFS_SIZE=1g
FRONTEND_MEMORY_LIMIT=1536m
FRONTEND_CPU_LIMIT=0.0
BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError

MEALCHECK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared AI deadlines and persistent per-user daily attempt/cost reservations.
# Cost values use the same currency as configured per-million token prices; zero disables the money cap.
MEALCHECK_REMOTE_TOTAL_TIMEOUT_SECONDS=60
# Raising the operation timeout requires aligning proxy/browser timeouts; see deploy/TIMEOUTS.md.
MEALCHECK_AI_OPERATION_TIMEOUT_SECONDS=120
MEALCHECK_AI_MAX_OUTPUT_TOKENS=2048
MEALCHECK_AI_BUDGET_ENABLED=true
MEALCHECK_AI_GLOBAL_DAILY_CALLS=100000
MEALCHECK_AI_INTERACTIVE_RESERVED_PERMITS=2
# Optional exact endpoint/model prices, all in one currency. Leave empty until verified.
MEALCHECK_AI_COST_CURRENCY=CNY
MEALCHECK_AI_PRICE_CATALOG_JSON=[]
# Shared admission covers synchronous and streaming assistant requests across backend instances.
MEALCHECK_ASSISTANT_DELIVERY_WORKERS=4
MEALCHECK_ASSISTANT_DELIVERY_QUEUE_CAPACITY=16
MEALCHECK_ASSISTANT_DELIVERY_LEASE_SECONDS=15
# local keeps existing upload files; oss enables private object references for new uploads.
MEALCHECK_IMAGE_STORAGE_PROVIDER=local
MEALCHECK_OSS_ENDPOINT=
MEALCHECK_OSS_REGION=
MEALCHECK_OSS_BUCKET=
MEALCHECK_OSS_PREFIX=mealcheck/
MEALCHECK_OSS_ACCESS_KEY_ID=
MEALCHECK_OSS_ACCESS_KEY_SECRET=
MEALCHECK_AI_GLOBAL_DAILY_COST=0
MEALCHECK_AI_GLOBAL_MAX_CONCURRENT_CALLS=42
MEALCHECK_AI_GLOBAL_MAX_STARTS_PER_MINUTE=120
MEALCHECK_AI_MAX_ADMISSION_WAITERS=1024
# Synthetic fixture diagnostics only: opt in with explicit authorized numeric user IDs.
MEALCHECK_ADVICE_AUDIT_ENABLED=false
MEALCHECK_ADVICE_AUDIT_USER_IDS=
MEALCHECK_ADVICE_AUDIT_MAX_FILES=500
MEALCHECK_AI_MINIMUM_HTTP_EXECUTION_MILLIS=1000
# Shared pacing matches the verified burst profile; 0 disables pacing.
MEALCHECK_AI_GLOBAL_MIN_START_INTERVAL_MILLIS=400
MEALCHECK_AI_DAILY_CALLS=100
MEALCHECK_AI_SYSTEM_DAILY_CALLS=5000
MEALCHECK_AI_DAILY_COST=0
MEALCHECK_AI_SYSTEM_DAILY_COST=0
MEALCHECK_AI_RESERVATION_COST=0.02
MEALCHECK_AI_BUDGET_ZONE=Asia/Shanghai
# Existing timestamp-without-time-zone values are interpreted in this zone.
# Keep UTC for the documented container deployment; audit older local data first.
MEALCHECK_TIMESTAMP_STORAGE_ZONE=UTC
MEALCHECK_BUSINESS_ZONE=Asia/Shanghai
VITE_BUSINESS_ZONE=Asia/Shanghai
VITE_LEGACY_TIMESTAMP_OFFSET=Z
MEALCHECK_ASSISTANT_EVALUATION_LEASE_SECONDS=90

# SiliconFlow Qwen starting guardrails, NOT verified supplier quotas or optimal values.
# Shared by vision/chat/review/advice for the same credential and model.
MEALCHECK_SF_QWEN_MAX_CONCURRENT_CALLS=10
MEALCHECK_SF_QWEN_MAX_STARTS_PER_MINUTE=40
# 0 disables TPM admission until the account quota is known. Input estimates are conservative.
MEALCHECK_SF_QWEN_MAX_TOKENS_PER_MINUTE=0
