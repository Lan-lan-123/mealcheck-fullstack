# Copy to .env.production on the server and set restrictive file permissions.
POSTGRES_DB=mealcheck
SPRING_DATASOURCE_USERNAME=mealcheck
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-database-password
SPRING_REDIS_PASSWORD=replace-with-a-long-random-redis-password
SPRING_RABBITMQ_USERNAME=mealcheck
SPRING_RABBITMQ_PASSWORD=replace-with-a-long-random-rabbit-password
MEALCHECK_ANALYSIS_DISPATCH=rabbitmq
MEALCHECK_ANALYSIS_CONCURRENCY=2
# Start conservatively with a real provider; the local 5-second stub passed with 8.
MEALCHECK_ANALYSIS_MAX_OUTSTANDING=8
MEALCHECK_ANALYSIS_MAX_OUTSTANDING_PER_USER=2
MEALCHECK_ANALYSIS_LEASE_SECONDS=90
MEALCHECK_UPLOAD_MAX_CONCURRENT_DECODES=2
MEALCHECK_UPLOAD_MAX_PENDING_DECODES=20
MEALCHECK_UPLOAD_DECODE_WAIT_MILLIS=8000
MEALCHECK_UPLOAD_TEMPORARY_MAX_BYTES=1073741824
MEALCHECK_RATE_LIMIT_UPLOAD_INGRESS_CAPACITY=20
RABBITMQ_MEMORY_LIMIT=512m
RABBITMQ_CPU_LIMIT=0.50
MEALCHECK_JWT_SECRET=replace-with-at-least-48-random-bytes
MEALCHECK_CORS_ALLOWED_ORIGINS=https://mealcheck.example.com
MEALCHECK_FRONTEND_PORT=8080
BACKEND_MEMORY_LIMIT=1g
BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError
BACKEND_CPU_LIMIT=1.50
FRONTEND_REQUEST_TMPFS_SIZE=256m
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.50
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.50

# Configure before enabling AI in production.
MEALCHECK_AI_API_KEY=
MEALCHECK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEALCHECK_AI_MODEL=qwen3-vl-30b-a3b-instruct
MEALCHECK_MCP_ENABLED=false
MEALCHECK_AI_INPUT_COST_PER_MILLION=0
MEALCHECK_AI_OUTPUT_COST_PER_MILLION=0

# Shared AI deadlines and persistent per-user daily attempt/cost reservations.
# Cost values use the same currency as configured per-million token prices; zero disables the money cap.
MEALCHECK_REMOTE_TOTAL_TIMEOUT_SECONDS=60
MEALCHECK_AI_OPERATION_TIMEOUT_SECONDS=120
MEALCHECK_AI_MAX_OUTPUT_TOKENS=2048
MEALCHECK_AI_BUDGET_ENABLED=true
# Shared across users, system jobs, task types, retries and backend replicas.
# Set monetary limits and verified model prices before a paid-provider load test.
MEALCHECK_AI_GLOBAL_DAILY_CALLS=5000
MEALCHECK_AI_GLOBAL_DAILY_COST=0
MEALCHECK_AI_GLOBAL_MAX_CONCURRENT_CALLS=10
MEALCHECK_AI_GLOBAL_MAX_STARTS_PER_MINUTE=120
MEALCHECK_AI_DAILY_CALLS=100
MEALCHECK_AI_SYSTEM_DAILY_CALLS=5000
MEALCHECK_AI_DAILY_COST=0
MEALCHECK_AI_SYSTEM_DAILY_COST=0
MEALCHECK_AI_RESERVATION_COST=0.02
MEALCHECK_AI_BUDGET_ZONE=Asia/Shanghai
