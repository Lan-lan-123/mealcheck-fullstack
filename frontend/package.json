{
  "name": "mealcheck-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:api",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test": "node --test test/*.test.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "lucide-react": "1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
